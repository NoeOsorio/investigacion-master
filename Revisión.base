views:
  - type: table
    name: Sin referencia
    filters:
      and:
        - tipo == "idea" || tipo == "diario"
        - referencias.isEmpty() || referencias.contains("pendiente")
    order:
      - file.name
      - tipo
      - estado
      - file.mtime
  - type: table
    name: Fuentes
    filters:
      and:
        - tipo == "fuente"
        - '!file.inFolder("Descartadas")'
    order:
      - file.name
      - autores
      - año
      - leido
      - uso
      - cita_a
  - type: table
    name: Ideas por uso
    filters:
      and:
        - tipo == "idea"
    groupBy:
      property: uso
      direction: ASC
    order:
      - file.name
      - estado
      - referencias
      - fundamenta
      - refuta
  - type: table
    name: Uso con IA
    filters:
      and:
        - tipo == "fuente"
        - '!file.inFolder("Descartadas")'
    groupBy:
      property: ia
      direction: ASC
    order:
      - file.name
      - ia
      - año
      - pdf
  - type: table
    name: Podcasts
    filters:
      and:
        - tipo == "podcast"
    order:
      - file.name
      - fecha
      - pregunta
      - fuentes
      - duracion
      - audio
  - type: table
    name: Arbitraje y versión
    filters:
      and:
        - tipo == "fuente"
        - '!file.inFolder("Descartadas")'
    groupBy:
      property: arbitraje
      direction: ASC
    order:
      - file.name
      - año
      - arbitraje
      - version
      - origen
  - type: table
    name: Descartadas
    filters:
      and:
        - file.inFolder("Descartadas")
    order:
      - file.name
      - arbitraje
      - descartada
